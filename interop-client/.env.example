# Must exactly match OIDC_REFERENCE_BASE_URL in reference-provider/.env
OIDC_INTEROP_PROVIDER_ISSUER=https://oidc-reference.loc
OIDC_INTEROP_CLIENT_ID=oidc-test-client
OIDC_INTEROP_CLIENT_SECRET=copy-from-reference-provider-env
# Must exactly match OIDC_REFERENCE_REDIRECT_URI in reference-provider/.env
OIDC_INTEROP_REDIRECT_URI=https://oidc-client.loc/callback
# Optional CA certificate bundle used by PHP cURL for the provider's local TLS certificate.
# Leave empty if the provider certificate is already trusted by the PHP/cURL CA store.
OIDC_INTEROP_CA_BUNDLE=

# Test-only reference-provider account used by the automated authorization-flow security checks.
# Copy these values from reference-provider/.env. Do not use real account credentials.
OIDC_INTEROP_TEST_USERNAME=alice
OIDC_INTEROP_TEST_PASSWORD=copy-from-reference-provider-env

# Required for Phase 6D.2 token revocation probe; must match reference-provider/.env.
OIDC_INTEROP_TEST_CONTROL_SECRET=copy-from-reference-provider-env

# Optional: when testing key rotation, require this retired key ID to remain published in JWKS.
# OIDC_INTEROP_EXPECT_RETIRED_KID=reference-rs256-2026
# Optional: when testing key rotation, require newly issued ID Tokens to use this active key ID.
# OIDC_INTEROP_EXPECT_ACTIVE_KID=reference-rs256-2027

# Phase 6D.3 signing-key rotation test. Use the provider key IDs configured for this test.
OIDC_INTEROP_ROTATION_OLD_KID=reference-rs256-2026
OIDC_INTEROP_ROTATION_NEW_KID=reference-rs256-2027
