# Public HTTPS origin used in discovery metadata. Configure an HTTPS Apache VirtualHost for this host.
OIDC_REFERENCE_BASE_URL=https://oidc-reference.loc
OIDC_REFERENCE_CLIENT_ID=oidc-test-client
OIDC_REFERENCE_CLIENT_SECRET=change-this-generated-secret
OIDC_REFERENCE_REDIRECT_URI=https://oidc-client.loc/callback
OIDC_REFERENCE_POST_LOGOUT_REDIRECT_URI=https://oidc-client.loc/signed-out
# Optional: advertise and deliver Back-Channel Logout to the sibling RP callback.
# OIDC_REFERENCE_BACKCHANNEL_LOGOUT_URI=https://oidc-client.loc/backchannel-logout
# OIDC_REFERENCE_BACKCHANNEL_CA_BUNDLE=C:/path/to/local-rp-ca.pem
# Optional: enable protected Dynamic Client Registration with a long random initial access token.
# OIDC_REFERENCE_REGISTRATION_INITIAL_ACCESS_TOKEN=generate-a-long-random-registration-token
OIDC_REFERENCE_TEST_USERNAME=alice
OIDC_REFERENCE_TEST_PASSWORD=change-this-test-password
OIDC_REFERENCE_DATA_DIR=var

# Phase 6D.2 security-test controls. Use only on this local test provider.
OIDC_REFERENCE_ACCESS_TOKEN_TTL_SECONDS=5
OIDC_REFERENCE_TEST_CONTROL_SECRET=generate-a-long-random-test-only-secret
# Optional key rotation: set active key paths/id and retain old public keys in JWKS.
# Increase the test ID Token lifetime temporarily to leave time for the rotation steps (max 3600).
OIDC_REFERENCE_ID_TOKEN_TTL_SECONDS=1800
# OIDC_REFERENCE_OIDC_KEY_ID=reference-rs256-2027
# OIDC_REFERENCE_OIDC_PRIVATE_KEY_PATH=var/keys/oidc-private-2027.pem
# OIDC_REFERENCE_OIDC_PUBLIC_KEY_PATH=var/keys/oidc-public-2027.pem
# OIDC_REFERENCE_RETIRED_OIDC_KEYS=reference-rs256-2026=var/keys/oidc-public-2026.pem
